{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "多用电表上半部分为表盘，下半部分为选择开关，开关周围标有测量功能的区域及量程。表面还包括指针定位螺丝、欧姆调零旋钮和表笔插孔。表盘有电阻刻度线、交流电压 $2.5\\ \\mathrm{V}$ 刻度线及直流电流、电压刻度线。",
      "title": "多用电表的表面结构",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "选择开关旋转到电阻挡、交直流电压挡或电流挡时，分别接通表内对应的电阻表、电压表或电流表电路。",
      "title": "选择开关的功能",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c3",
      "source_node_ids": [
        "n-9eae2bbed8878aab2412"
      ],
      "text": "多用电表的工作原理涉及闭合电路欧姆定律以及电路的串联与并联。原文电阻挡内部电路由电源 $E$、$r$、表头 $\\mathrm{G}$ 和可调电阻 $R$ 串联组成，两端连接红、黑表笔。",
      "title": "电阻挡的内部电路",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c4",
      "source_node_ids": [
        "n-5bcb3ce836c79f41d367"
      ],
      "text": "电阻挡表盘刻度不均匀，具有左密右疏的特点，估读时容易产生误差。",
      "title": "电阻挡的刻度特点",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-9eae2bbed8878aab2412"
      ],
      "text": "电阻挡红、黑表笔短接时，$I_g=\\dfrac{E}{R_g+R+r}$；将被测电阻 $R_x$ 接在红、黑表笔之间时，$I=\\dfrac{E}{R_g+R+r+R_x}$。",
      "title": "电阻挡的电流关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l2",
      "source_node_ids": [
        "n-9eae2bbed8878aab2412"
      ],
      "text": "二极管具有单向导电性。加正向电压时，电阻很小，电路导通，原文串联电路中的灯亮；加反向电压时，电阻很大，电路断路，灯不亮。",
      "title": "二极管的单向导电性",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l3",
      "source_node_ids": [
        "n-5f2fd9cd3502f0e1cd8f",
        "n-668721abd85204da147a"
      ],
      "text": "测电阻时，电阻值等于指针在电阻刻度盘上的示数与所选挡位倍率的乘积。",
      "title": "电阻测量值与示数、倍率的关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l4",
      "source_node_ids": [
        "n-5bcb3ce836c79f41d367"
      ],
      "text": "多用电表内部电池用旧后，电动势会减小，使电阻测量值偏大。",
      "title": "内部电池老化对电阻测量的影响",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "检查指针是否停在表盘刻度左端的零位置；若不指零，调节指针定位螺丝进行机械调零。",
      "title": "机械调零",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "将红、黑表笔分别插入“$+$”“$-$”插孔，保证电流“红进黑出”。测电压时，多用电表与被测元件并联；测电流时，多用电表与被测元件串联。",
      "title": "测量电压和电流的接线",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "测量前使待测电阻与其他元件和电源断开，根据估计阻值选择合适挡位，将两表笔短接并进行欧姆调零。把待测电阻接在两表笔之间，待指针稳定后检查其是否在中值附近，否则换挡；每换一次挡必须重新欧姆调零。读出刻度盘示数，乘所选挡位倍率得到测量结果。",
      "title": "测量定值电阻",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "使用电阻挡时，将两表笔短接，进行欧姆调零；每换一次挡必须重新欧姆调零。",
      "title": "欧姆调零",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "电阻挡欧姆调零后，将二极管接在两表笔之间。若指针偏角很大、读数很小，黑表笔接触二极管正极，红表笔接触负极；若指针偏角很小、读数很大，黑表笔接触二极管负极，红表笔接触正极。",
      "title": "测二极管正反向电阻并判别极性",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-5f2fd9cd3502f0e1cd8f"
      ],
      "text": "测电压和电流时，若所读表盘最小刻度为 $1$、$0.1$、$0.01$ 等，需往后估读一位；若最小刻度为 $0.2$、$0.02$、$0.5$、$0.05$ 等，估读到本位。",
      "title": "电压和电流的估读",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m7",
      "source_node_ids": [
        "n-5bcb3ce836c79f41d367",
        "n-668721abd85204da147a"
      ],
      "text": "电阻挡指针偏转过大或过小都会使误差增大，应选择恰当挡位，使指针落在表盘中间区域、中值附近。",
      "title": "选择电阻挡以减小读数误差",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m8",
      "source_node_ids": [
        "n-5bcb3ce836c79f41d367"
      ],
      "text": "读数时的观测容易产生偶然误差，应使视线垂直表盘，正对指针读数。",
      "title": "正确观察指针读数",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m9",
      "source_node_ids": [
        "n-5bcb3ce836c79f41d367"
      ],
      "text": "内部电池用旧、电动势减小时，会使电阻测量值偏大，应及时更换新电池。",
      "title": "及时更换内部电池",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m10",
      "source_node_ids": [
        "n-668721abd85204da147a"
      ],
      "text": "多用电表使用完毕后，选择开关应置于“OFF”挡；长期不用时应取出电池。",
      "title": "使用后的处理与存放",
      "status": "机器整理（待核对）"
    }
  ],
