{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-380f6a8ae24014f7c273"
      ],
      "text": "油酸酒精溶液在平静的水面上形成单分子油酸薄膜，油酸分子在水面上排成一层，薄膜厚度近似等于油酸分子的直径。",
      "title": "单分子油酸薄膜",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-6af9fe971e5d04c4ef43"
      ],
      "text": "油酸酒精溶液的实际浓度、一滴油酸酒精溶液的实际体积与理论值间存在偏差；采用“互补法”计算获得的油膜面积与实际油膜面积间也存在偏差。",
      "title": "油膜法实验的误差来源",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-380f6a8ae24014f7c273"
      ],
      "text": "在平静水面上形成单分子油酸薄膜时，用 $D=\\dfrac VS$ 计算薄膜厚度，该厚度近似等于油酸分子的直径。其中 $V$ 为一滴油酸酒精溶液中所含纯油酸的体积，$S$ 为油酸薄膜面积。",
      "title": "油膜厚度与分子直径的估测关系",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-31229037ffa2ef5a0597"
      ],
      "text": "取纯油酸 $1\\ \\mathrm{mL}$，注入 $500\\ \\mathrm{mL}$ 的容量瓶中，再注入酒精，直到液面达到 $500\\ \\mathrm{mL}$ 刻度线。",
      "title": "配制油酸酒精溶液",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-31229037ffa2ef5a0597"
      ],
      "text": "用注射器或滴管将油酸酒精溶液逐滴滴入量筒，记录量筒内增加一定体积 $V_n$ 时的滴数 $n$，根据 $V_0=\\dfrac{V_n}{n}$ 算出一滴油酸酒精溶液的体积 $V_0$。",
      "title": "测量一滴油酸酒精溶液的体积",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-31229037ffa2ef5a0597"
      ],
      "text": "向浅盘内倒入约 $2\\ \\mathrm{cm}$ 深的水，将爽身粉均匀撒在水面上；用注射器或滴管将一滴油酸酒精溶液滴在水面上，待形状稳定后形成待测油酸薄膜。",
      "title": "形成待测油酸薄膜",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-31229037ffa2ef5a0597"
      ],
      "text": "将玻璃板放在浅盘上，用彩笔在玻璃板上描画油酸薄膜的轮廓；将画有轮廓的玻璃板放在坐标纸上，算出油酸薄膜面积 $S$。",
      "title": "描绘轮廓并测量油膜面积",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-6af9fe971e5d04c4ef43"
      ],
      "text": "计算油膜面积时采用“互补法”：不足半格的舍去，大于半格的算一格。按此方法获得的油膜面积与实际油膜面积间存在偏差。",
      "title": "用互补法计算油膜面积",
      "status": "机器整理（待核对）"
    }
  ],
