{
  "concepts": [],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-f46bb12760137230e6a5",
        "n-1dfb9e8fe0fd43cfa8c6"
      ],
      "text": "在气体质量和温度不变的条件下，气体压强与体积成反比；气体等温变化的 $p-\\dfrac1V$ 图像是过原点的倾斜直线。",
      "title": "一定质量气体等温变化时压强与体积的关系",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-f46bb12760137230e6a5"
      ],
      "text": "控制气体质量和温度不变，用注射器、压力表、柱塞和橡胶套组成的装置研究气体压强与体积的关系。",
      "title": "控制质量和温度研究压强与体积的关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-a64f8a9ee78a1eabfac3"
      ],
      "text": "按图示安装器材，利用注射器下端的橡胶套和柱塞共同封闭一段空气柱，以确保气体质量不变。",
      "title": "封闭空气柱以保持气体质量不变",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-a64f8a9ee78a1eabfac3"
      ],
      "text": "用手缓慢地把柱塞向下压，选取几个位置，待示数稳定后读出刻度尺示数与压力表示数并记录；再缓慢把柱塞向上拉，选取几个位置，待示数稳定后读出两表示数并记录。刻度尺示数可以直接表示空气柱体积。",
      "title": "测量不同状态下气体的体积和压强",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-1dfb9e8fe0fd43cfa8c6"
      ],
      "text": "以压强 $p$ 为纵坐标、体积的倒数 $\\dfrac1V$ 为横坐标，建立 $p-\\dfrac1V$ 坐标系并作图。图线为过原点的倾斜直线，说明压强与体积成反比。原文指出，作 $p-V$ 图像无法说明压强与体积的关系。",
      "title": "用压强与体积倒数的图像处理数据",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-e88a6e66b81c5ad25156"
      ],
      "text": "从气体质量、温度和测量读数三个方面分析误差：橡胶套密封不严会使空气柱质量变化；环境温度变化，或柱塞向下压、向上拉时滑动过快，会使空气柱温度变化；空气柱长度的测量、压力表的读数等也会引起误差。",
      "title": "分析密封、温度变化和测量读数引起的误差",
      "status": "机器整理（待核对）"
    }
  ],
