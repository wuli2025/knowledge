{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-7e5395a5865efecde1a6"
      ],
      "text": "抛体运动中的临界问题常以“恰好通过某处”“满足某种条件的最大或最小初速度”“速度恰沿某方向”等形式描述。",
      "title": "抛体运动中的临界问题",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-dddb2f9f677d5829e5eb"
      ],
      "text": "利用抛体运动规律和几何关系建立相关函数关系式，求解有关物理量的最大值或最小值。",
      "title": "抛体运动中的极值问题",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c3",
      "source_node_ids": [
        "n-3473e8ad84491769e149"
      ],
      "text": "相遇的特点是两物体同一时刻到达空间同一位置。常见类型有平抛与直线运动相遇、平抛与平抛相遇、平抛与竖直上抛相遇、平抛与斜抛相遇等。",
      "title": "抛体运动中的相遇问题",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-7e5395a5865efecde1a6"
      ],
      "text": "画出运动草图，寻找临界点，确定临界条件，进而确定已知量与未知量的关系。",
      "title": "临界条件分析法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-dddb2f9f677d5829e5eb"
      ],
      "text": "利用抛体运动规律和几何关系得到相关函数关系式，再用数学方法求最大值或最小值；常见方法包括二次函数求极值、均值不等式求极值、导数求极值。",
      "title": "建立函数关系求极值",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-edac14c2fce35874cfb9"
      ],
      "text": "针对不计空气阻力、从跳台水平跳向倾角为 $45^\\circ$ 的斜坡的情境：确定运动形式并建立坐标系，分析水平、竖直位移随时间变化的规律及其与跳台高度 $h$ 的关系；建立落到斜坡时速度与时间的关系，再利用均值不等式求速度最小值。",
      "title": "平抛落斜坡的速度极值分析",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-87f8bb069327272f1726"
      ],
      "text": "建立合适的坐标系，将三维问题降为二维问题，把立体空间问题转换为平面问题，结合运动合成与分解的思想“化曲为直”进行求解。",
      "title": "立体空间抛体问题的降维求解",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-ead6a9d2140e3efb8407"
      ],
      "text": "先明确问题本质，判断是否可以使用降维法；选择两个合适的平面观察问题；在选定平面上选择合适的物理规律求解；最后整合不同平面的求解结果。",
      "title": "降维法的一般步骤",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-3473e8ad84491769e149"
      ],
      "text": "利用运动的合成与分解，将二维追及相遇问题转化为一维追及相遇问题；根据运动过程草图寻找位移关系、速度关系和时间关系。",
      "title": "抛体相遇问题的分解法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m7",
      "source_node_ids": [
        "n-f19f5e0cb6ce266cf1db"
      ],
      "text": "在忽略空气阻力、两谷粒由同一点 $O$ 抛出并经过同一点 $P$ 的题设中，分别分析竖直分运动：斜抛谷粒的竖直分运动为竖直上抛，平抛谷粒的竖直分运动为自由落体；利用两谷粒从 $O$ 到 $P$ 的位移相同，确定水平位移相同、竖直位移也相同。",
      "title": "同起点同终点抛体运动的分量分析",
      "status": "机器整理（待核对）"
    }
  ],
