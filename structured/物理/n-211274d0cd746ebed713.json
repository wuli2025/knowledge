{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-5bbe810951ed036fff5f",
        "n-d2931149d6b29d59dab2"
      ],
      "text": "实验图像中的横坐标 $x$ 表示弹簧的形变量，不是弹簧的长度；纵坐标 $F$ 表示弹簧的弹力。",
      "title": "弹簧形变量与弹力的图像表示",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-5bbe810951ed036fff5f",
        "n-3b605ff70f43e99c8e41"
      ],
      "text": "实验应避免弹簧被过度拉伸。悬挂钩码过多会使弹簧形变过大，超出弹性限度，此时不再符合胡克定律。",
      "title": "弹性限度",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-3b605ff70f43e99c8e41",
        "n-d2931149d6b29d59dab2"
      ],
      "text": "弹簧形变未超出弹性限度时，符合胡克定律（$F=kx$）。在实验误差允许的范围内，弹力与弹簧形变量的比值不变。",
      "title": "胡克定律",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-5cdd896e2a0c2ecb768c"
      ],
      "text": "将弹簧竖直悬挂于支架上，下端悬挂钩码，旁边竖直放置刻度尺。平衡时记录弹簧的总长度和钩码重力；改变钩码个数，重复实验，将数据填入表格，分析弹力大小与形变量之间的关系。",
      "title": "改变钩码个数采集实验数据",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-5bbe810951ed036fff5f"
      ],
      "text": "所挂钩码不要过重，以免弹簧被过度拉伸，超出弹性限度。",
      "title": "控制钩码质量",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-5bbe810951ed036fff5f"
      ],
      "text": "在竖直悬挂弹簧的实验中，考虑弹簧自身重力的影响，应将弹簧竖直悬挂测量原长，不可将其放在水平桌面上测量原长。",
      "title": "竖直悬挂实验的原长测量",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-5bbe810951ed036fff5f"
      ],
      "text": "在弹簧竖直悬挂且处于稳定状态时测量其长度。刻度尺保持竖直并靠近弹簧，以免增大读数误差。",
      "title": "弹簧长度的测量",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-d2931149d6b29d59dab2",
        "n-5bbe810951ed036fff5f"
      ],
      "text": "根据测量数据，在直角坐标系中以弹簧弹力 $F$ 为纵轴、形变量 $x$ 为横轴描点，再根据描点情况作出一条直线。坐标轴标度应适中，并标注单位；所描的点不一定都落在直线上，应使各点均匀分布在直线两侧。",
      "title": "图像法处理实验数据",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-d2931149d6b29d59dab2"
      ],
      "text": "将实验数据填入表中，研究测量数据，考察在实验误差允许的范围内弹力与弹簧形变量的比值是否不变。",
      "title": "列表法处理实验数据",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m7",
      "source_node_ids": [
        "n-d2931149d6b29d59dab2"
      ],
      "text": "根据实验数据，找出弹力与弹簧形变量的函数关系。",
      "title": "函数法处理实验数据",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m8",
      "source_node_ids": [
        "n-3b605ff70f43e99c8e41"
      ],
      "text": "分析实验误差时，应考虑钩码标值不准确、弹簧长度测量不准确，以及画图时描点连线不准确等因素。",
      "title": "实验误差来源分析",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m9",
      "source_node_ids": [
        "n-3b605ff70f43e99c8e41"
      ],
      "text": "悬挂钩码过多，使弹簧形变超出弹性限度时，不再符合胡克定律（$F=kx$），$F$—$x$ 图像会发生弯曲。原文图甲中，图线起初为过原点的直线，随后向上弯曲。",
      "title": "分析超出弹性限度引起的图像弯曲",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m10",
      "source_node_ids": [
        "n-3b605ff70f43e99c8e41"
      ],
      "text": "若水平放置弹簧测量原长，再将其悬挂起来，弹簧自重会使其产生一定伸长量，导致图像横轴截距不为 $0$。原文图乙中，实线与过原点的斜虚线平行，并在横轴正半轴上有非零截距。",
      "title": "分析原长测量方式引起的横轴截距",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m11",
      "source_node_ids": [
        "n-41b99a76e52d74d9470d"
      ],
      "text": "将弹簧水平放置在桌面上，一端固定，另一端连接细绳，细绳跨过桌边定滑轮后悬挂钩码；刻度尺沿弹簧方向水平放置。该横向测量方案用于消除弹簧自身重力对原长测量的影响，减小测量误差。",
      "title": "横向测量改进方案",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m12",
      "source_node_ids": [
        "n-df4896732c34e6968774"
      ],
      "text": "将弹簧竖直设置，下端连接放在压力传感器上的重物，旁设刻度尺，用压力传感器间接测量弹簧弹力的大小。",
      "title": "压力传感器间接测量弹力",
      "status": "机器整理（待核对）"
    }
  ],
