{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-2f1152ca33be0fd83770"
      ],
      "text": "带电粒子进入电场时初速度为 $0$，或初速度方向与电场方向平行，在静电力作用下做加速、减速交替进行的直线运动。",
      "title": "交变电场中的直线运动模型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-2f1152ca33be0fd83770"
      ],
      "text": "带电粒子以一定的初速度垂直于电场方向进入交变电场，粒子做曲线运动。",
      "title": "交变电场中的曲线运动模型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c3",
      "source_node_ids": [
        "n-846816d605534134848c"
      ],
      "text": "带电粒子在交变电场中的运动往往具备时间上的周期性与空间上的对称性；常见运动情况包括单向直线运动、往返运动和类平抛运动。",
      "title": "交变电场中运动的周期性与对称性",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-9d0d1ac2b1f54010ab2f"
      ],
      "text": "$v-t$ 图像的图线斜率表示加速度。",
      "title": "速度—时间图像的斜率意义",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l2",
      "source_node_ids": [
        "n-9d0d1ac2b1f54010ab2f",
        "n-2f1152ca33be0fd83770"
      ],
      "text": "$v-t$ 图线与横轴围成的面积表示位移；曲线运动中，$y$ 方向的位移可用 $v_y-t$ 图线与横轴围成的“面积”求解。",
      "title": "速度—时间图像的面积意义",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l3",
      "source_node_ids": [
        "n-2f1152ca33be0fd83770"
      ],
      "text": "带电粒子以一定的初速度垂直于电场方向进入交变电场，运动时间较长时，沿初速度方向做匀速直线运动，沿垂直于初速度方向可利用 $v_y-t$ 图像分析。",
      "title": "曲线运动的分运动特点",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l4",
      "source_node_ids": [
        "n-9d0d1ac2b1f54010ab2f"
      ],
      "text": "原文表述：“图线与时间轴有交点，表示此时速度改变方向。”【待核对】该表述中由交点判定速度改变方向的条件需核对。",
      "title": "速度—时间图像与运动方向的判读",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-846816d605534134848c"
      ],
      "text": "先将电场随时间的周期性变化转换为静电力随时间的周期性变化，再根据受力分析确定粒子的运动情况。可从力与运动的关系、动量和能量等角度分析。",
      "title": "受力分析与运动分析",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-2f1152ca33be0fd83770"
      ],
      "text": "对交变电场中的直线运动，通常用动力学知识结合运动学图像求解，重点分析各段时间内的加速度、运动性质以及每段运动时间与交变电场周期 $T$ 的关系。",
      "title": "直线运动的动力学与图像分析",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-2f1152ca33be0fd83770"
      ],
      "text": "带电粒子垂直于电场方向进入交变电场，若初速度很大、通过交变电场所用时间极短，可认为粒子所受静电力为恒力，按类平抛运动处理。",
      "title": "短时间通过电场的类平抛近似",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-2f1152ca33be0fd83770"
      ],
      "text": "对在交变电场中运动时间较长的曲线运动，沿初速度方向按匀速直线运动分析，垂直于初速度方向利用 $v_y-t$ 图像分析，并用图线与横轴围成的“面积”求侧向位移。",
      "title": "运动分解与侧向速度图像法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-9d0d1ac2b1f54010ab2f"
      ],
      "text": "利用 $v-t$ 图像分析时，应注意粒子进入电场的时刻，并应用运动的对称性和周期性变化关系。原文还指出，若粒子穿过交变电场的时间极短，可将该段时间内的电场视为匀强电场。",
      "title": "入场时刻与周期性分析",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-9d0d1ac2b1f54010ab2f"
      ],
      "text": "对运动复杂、不易画出图像的问题，应逐段分析求解。",
      "title": "复杂运动的逐段分析法",
      "status": "机器整理（待核对）"
    }
  ],
