{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-b3721d3e262a259b91fc"
      ],
      "text": "初速度为 $0$，加速度大小为 $g$、方向竖直向下的匀加速直线运动。",
      "title": "自由落体运动",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-113a7e56e34b71a3a63d"
      ],
      "text": "初速度方向竖直向上，加速度大小为 $g$、方向竖直向下。上升阶段为匀减速直线运动，下降阶段为自由落体运动。",
      "title": "竖直上抛运动",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c3",
      "source_node_ids": [
        "n-e05c9b19f9467fd56be4"
      ],
      "text": "物体经过抛出点上方某个位置（最高点除外）时，可能处于上升阶段，也可能处于下降阶段；只知道物体与抛出点的距离关系时，物体可能在抛出点上方，也可能在抛出点下方。",
      "title": "竖直上抛运动的多解性",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c4",
      "source_node_ids": [
        "n-5d4fa50de29008357e14"
      ],
      "text": "一个物体的运动包含几个阶段，各阶段的运动性质不同，满足不同的运动规律。",
      "title": "单物体的多过程运动",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-b3721d3e262a259b91fc"
      ],
      "text": "自由落体运动中，以竖直向下为正方向，速度与时间关系式为 $v=gt$。",
      "title": "自由落体运动的速度与时间关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l2",
      "source_node_ids": [
        "n-b3721d3e262a259b91fc"
      ],
      "text": "自由落体运动中，以竖直向下为正方向，位移与时间关系式为 $h=\\frac{1}{2}gt^2$。",
      "title": "自由落体运动的位移与时间关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l3",
      "source_node_ids": [
        "n-b3721d3e262a259b91fc"
      ],
      "text": "自由落体运动中，以竖直向下为正方向，速度与位移关系式为 $v^2=2gh$。",
      "title": "自由落体运动的速度与位移关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l4",
      "source_node_ids": [
        "n-113a7e56e34b71a3a63d"
      ],
      "text": "竖直上抛运动中，以竖直向上为正方向，速度与时间关系式为 $v=v_0-gt$。",
      "title": "竖直上抛运动的速度与时间关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l5",
      "source_node_ids": [
        "n-113a7e56e34b71a3a63d"
      ],
      "text": "竖直上抛运动中，以竖直向上为正方向，位移与时间关系式为 $h=v_0t-\\frac{1}{2}gt^2$。",
      "title": "竖直上抛运动的位移与时间关系",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l6",
      "source_node_ids": [
        "n-113a7e56e34b71a3a63d"
      ],
      "text": "竖直上抛运动上升的最大时间为 $t_{\\max}=\\frac{v_0}{g}$。",
      "title": "竖直上抛运动的上升时间",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l7",
      "source_node_ids": [
        "n-113a7e56e34b71a3a63d"
      ],
      "text": "竖直上抛运动上升的最大高度为 $h_{\\max}=\\frac{v_0^2}{2g}$。",
      "title": "竖直上抛运动的最大上升高度",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l8",
      "source_node_ids": [
        "n-94783e725b9e4bec047f"
      ],
      "text": "竖直上抛路径上，$C$ 点在 $A$ 点上方。物体上升过程中从 $A$ 到 $C$ 所用时间 $t_{AC}$ 和下降过程中从 $C$ 到 $A$ 所用时间 $t_{CA}$ 相等。",
      "title": "竖直上抛运动的时间对称性",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l9",
      "source_node_ids": [
        "n-94783e725b9e4bec047f"
      ],
      "text": "物体上升过程中经过 $A$ 点的速度与下降过程中经过 $A$ 点的速度大小相等。",
      "title": "竖直上抛运动的速度对称性",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l10",
      "source_node_ids": [
        "n-94783e725b9e4bec047f"
      ],
      "text": "竖直上抛路径上，$B$ 点在 $A$ 点上方。物体从 $A$ 到 $B$ 和从 $B$ 到 $A$ 的重力势能变化量大小相等，均等于 $mgh_{AB}$。",
      "title": "竖直上抛运动的能量对称性",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-8abe988557365aebd248"
      ],
      "text": "将竖直上抛运动分为上升和下降两个阶段：上升阶段按加速度大小 $a=g$ 的匀减速直线运动处理，下降阶段按自由落体运动处理。",
      "title": "竖直上抛运动的分段法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-8abe988557365aebd248"
      ],
      "text": "以竖直向上为正方向，将全过程作为初速度方向竖直向上、加速度为 $-g$ 的匀变速直线运动处理。若 $v>0$，物体上升；若 $v<0$，物体下落。若 $h>0$，物体在抛出点上方；若 $h<0$，物体在抛出点下方。",
      "title": "竖直上抛运动的全程法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-e05c9b19f9467fd56be4"
      ],
      "text": "分析竖直上抛运动的多解性时，分别考虑运动方向和位置的不确定性：对抛出点上方某个位置（最高点除外），考虑上升与下降两种阶段；对仅给出距抛出点距离的条件，考虑抛出点上方与下方两种位置。",
      "title": "竖直上抛运动的多解情形分析",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-5d4fa50de29008357e14"
      ],
      "text": "研究多个物体在空间上重复同样的运动时，可用一个物体的运动代替多个物体的运动，将照片中多个物体的位置看作一个物体在不同时刻的位置。水龙头滴水、直升机定点空降、小球在斜面上每隔一定时间间隔连续释放等，可据此转换为单物体问题求解。",
      "title": "多物体问题转换为单物体问题",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-12464d9cc7a8b24fad54"
      ],
      "text": "多过程运动在转折点的速度是联系相邻两个运动过程的纽带，对转折点速度的求解往往是解题关键。",
      "title": "利用转折点速度衔接相邻过程",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-d986103517f5a7a028ce"
      ],
      "text": "在列车限速通过隧道的情境中，求最短时间时，加速和减速过程应以最大加速度进行，匀速过程以允许的最大速度 $v$ 通过隧道。“任一部分处于隧道内”的限速范围为列车头刚进隧道至列车尾离开隧道的过程。按匀减速、匀速、匀加速三个阶段分析，列车头到达隧道入口时开始匀速，列车尾离开隧道出口时开始匀加速。",
      "title": "限速通过隧道的最短时间分析",
      "status": "机器整理（待核对）"
    }
  ],
