{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-5e3e0ef7f529b3aaeac3"
      ],
      "text": "动态平衡是指物体的受力状态缓慢发生变化，但在变化过程中，每一个状态均可视为平衡状态。",
      "title": "动态平衡",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-b013cfb0a7e9d6f46265"
      ],
      "text": "某物理量变化会引起其他物理量变化，使物体所处的平衡状态“恰好出现”或“恰好不出现”。问题描述中常用“刚好”“恰能”“恰好”等词语。",
      "title": "平衡中的临界问题",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c3",
      "source_node_ids": [
        "n-b872214cdee9431e2b5a"
      ],
      "text": "平衡中的极值问题，一般指力的变化过程中的最大值和最小值问题。",
      "title": "平衡中的极值问题",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-b4ddd3220cc0a4240bca"
      ],
      "text": "物体由静止到运动的临界状态，摩擦力达到最大静摩擦力。",
      "title": "开始运动的摩擦临界条件",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l2",
      "source_node_ids": [
        "n-b4ddd3220cc0a4240bca"
      ],
      "text": "绳子恰好绷紧时，拉力 $F=0$。",
      "title": "绳子恰好绷紧的临界条件",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l3",
      "source_node_ids": [
        "n-b4ddd3220cc0a4240bca"
      ],
      "text": "物体刚好离开接触面时，支持力 $F_{\\mathrm N}=0$。",
      "title": "刚好离开接触面的临界条件",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-5e3e0ef7f529b3aaeac3"
      ],
      "text": "处理动态平衡问题的核心思想是“化动为静，静中求动”：将缓慢变化过程中的每一个状态视为平衡状态。",
      "title": "动态平衡的处理思想",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-3448e8f7446488d706d8"
      ],
      "text": "适用于物体受三个力，其中一个力恒定，一个力方向不变，第三个力大小、方向均变化的情况。构建力的矢量三角形，根据各边的长短及方向的变化判断各力的变化。",
      "title": "图解法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-b82e589584edb9759253"
      ],
      "text": "适用于物体受三个力，其中一个力恒定，其他两个力方向均变化，且力的矢量三角形与某几何三角形相似的情况。利用三角形相似得到力与对应边的比值，根据几何三角形边长变化判断力的大小变化。",
      "title": "相似三角形法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-7392b0f11b9554aa9585"
      ],
      "text": "适用于物体受三个力，其中一个力大小、方向不变，另两个力方向均改变，但这两个变化力之间的夹角不变的情况。构建力的矢量三角形，以恒定的力为弦作其外接圆，根据两变化力在圆周上移动过程中对应矢量三角形边长的变化判断力的大小变化。",
      "title": "辅助圆法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-835041cf12e041617669"
      ],
      "text": "先进行受力分析，判断物体受力情况；作出辅助线，构建力的矢量三角形；分析题目给出的信息，根据正弦定理确定边角关系，再根据角和边的变化判断力的大小变化。",
      "title": "正弦定理法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-617a0b82fe37fb714cdc"
      ],
      "text": "解决平衡中的极值问题时，根据平衡条件作出力的矢量图，通过物理过程分析，利用平行四边形定则或三角形定则进行动态分析，确定最大值或最小值。",
      "title": "求极值的物理分析法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m7",
      "source_node_ids": [
        "n-617a0b82fe37fb714cdc"
      ],
      "text": "通过分析问题，根据物体的平衡条件列出物理量之间的函数关系，用数学方法求极值，如二次函数求极值、三角函数求极值等。",
      "title": "求极值的数学分析法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m8",
      "source_node_ids": [
        "n-617a0b82fe37fb714cdc"
      ],
      "text": "正确进行受力分析和变化过程分析，找出平衡的临界点和极值点。临界条件必须在变化中寻找，不能停留在一个状态研究临界问题；要把某个物理量推向极端，即极大或极小。",
      "title": "极限分析法",
      "status": "机器整理（待核对）"
    }
  ],
