{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-652c3530253b83d184d9"
      ],
      "text": "将问题涉及的全部气体作为整体研究对象，这些气体的状态不管怎样变化，其总质量都不变。",
      "title": "变质量问题中的定质量气体整体",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-3e2aa3979ae9923c4ce0"
      ],
      "text": "原文给出的理想气体状态方程分态式为 $\\dfrac{p_1V_1}{T_1}+\\dfrac{p_2V_2}{T_2}+\\cdots=\\dfrac{p_1'V_1'}{T_1'}+\\dfrac{p_2'V_2'}{T_2'}+\\cdots$，可用于气体变质量问题的求解。",
      "title": "理想气体状态方程的分态式",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l2",
      "source_node_ids": [
        "n-3e2aa3979ae9923c4ce0"
      ],
      "text": "原文给出的玻意耳定律应用形式为 $p_1V_1+p_2V_2+\\cdots=pV$，可用于气体变质量问题的求解。",
      "title": "玻意耳定律的应用形式",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-a50b7b9cf648ed9ffad0",
        "n-652c3530253b83d184d9"
      ],
      "text": "把变质量问题转化为定质量问题：将问题涉及的全部气体选为研究对象，使所研究气体的总质量保持不变。",
      "title": "变质量问题转化为定质量问题",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-652c3530253b83d184d9"
      ],
      "text": "处理充气或打气问题时，将即将充进容器内的气体和容器内原有气体构成的整体作为研究对象。",
      "title": "充气问题的研究对象选择",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-652c3530253b83d184d9"
      ],
      "text": "处理灌气或分装问题时，把大容器中的剩余气体和多个小容器中的气体构成的整体作为研究对象。",
      "title": "灌气分装问题的研究对象选择",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-652c3530253b83d184d9"
      ],
      "text": "处理漏气问题时，选容器内剩余气体和漏出气体构成的整体作为研究对象。",
      "title": "漏气问题的研究对象选择",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-652c3530253b83d184d9"
      ],
      "text": "处理抽气问题时，将每次抽气过程中抽出的气体和剩余气体构成的整体作为研究对象。",
      "title": "抽气问题的研究对象选择",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-3e2aa3979ae9923c4ce0"
      ],
      "text": "根据问题选择适当的方程，应用理想气体状态方程的分态式求解，或巧妙应用玻意耳定律求解。",
      "title": "选择适当的气体方程",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m7",
      "source_node_ids": [
        "n-a49c2cce734cbdb99246"
      ],
      "text": "按“审—定—列”流程求解。审：审清题意，明确物理过程，找出初态、末态和中间态。定：确定气体变质量问题类型，选定合适的研究对象。列：找出各个状态的气体状态参量，应用理想气体状态方程或玻意耳定律列出适当方程，联立求解。",
      "title": "气体变质量问题的审题与列式流程",
      "status": "机器整理（待核对）"
    }
  ],
