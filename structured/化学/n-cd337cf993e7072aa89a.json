{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-00dcc435f6e915e5cfcb"
      ],
      "text": "探究实验方案的评价类型包括装置评价型和原理评价型。装置评价型关注装置的合理性及操作的简便可行性；原理评价型紧扣实验目的，关注原理是否科学、是否节省原料、误差是否较小。",
      "title": "探究实验方案的评价类型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-3766f094b85977a761a0"
      ],
      "text": "探究实验方案的评价角度包括实验用品选择的评价、不同实验方案的评价和最佳方案的选用。实验用品选择涉及仪器、试剂及连接方式。",
      "title": "探究实验方案的评价角度",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-5650d225ca5620f06263"
      ],
      "text": "按“观察物质→预测物质的性质→实验和观察→推理及结论”的过程设计探究实验。实验和观察与性质预测之间可反复进行。",
      "title": "探究物质性质的实验设计流程",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-5650d225ca5620f06263"
      ],
      "text": "运用分类的方法，根据物质所属的类别或利用有关反应规律预测物质的性质。",
      "title": "预测物质性质",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-5650d225ca5620f06263"
      ],
      "text": "通过实验和观察验证预测，并作出新的预测；发现特殊现象时提出新问题，可继续进行性质预测、实验和观察。",
      "title": "实验验证与提出新问题",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m4",
      "source_node_ids": [
        "n-5650d225ca5620f06263"
      ],
      "text": "对实验现象进行分析、综合、推理，概括出结论；运用比较的方法，归纳物质的通性及特性。",
      "title": "由实验现象归纳性质",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m5",
      "source_node_ids": [
        "n-00dcc435f6e915e5cfcb"
      ],
      "text": "对比各方案的装置，从装置的合理性、操作的简便可行性等方面分析，选出最佳装置。",
      "title": "装置评价法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m6",
      "source_node_ids": [
        "n-00dcc435f6e915e5cfcb"
      ],
      "text": "紧扣实验目的，综合考虑各方案的原理，从原理是否科学、是否节省原料、误差是否较小等方面分析，设计或选出最佳方案。",
      "title": "原理评价法",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m7",
      "source_node_ids": [
        "n-3766f094b85977a761a0"
      ],
      "text": "评价仪器选择时，考察发生装置、净化装置、干燥装置、收集装置和尾气处理装置等，其中净化装置包括除杂试剂及其使用顺序；评价试剂选择时，考察种类、状态、浓度等；评价连接方式时，考察仪器连接的先后顺序和导管接口的连接方式等。",
      "title": "实验用品及连接方式的评价",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m8",
      "source_node_ids": [
        "n-3766f094b85977a761a0"
      ],
      "text": "对几个实验方案从是否正确、严密等方面作出判断，考虑方案是否合理、有无干扰现象、经济上是否划算以及对环境有无污染等。",
      "title": "不同实验方案的综合评价",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m9",
      "source_node_ids": [
        "n-3766f094b85977a761a0"
      ],
      "text": "若几个实验方案都能达到目的，应多角度分析优劣并选出最佳方案。最佳方案一般具有装置最简单、药品易得且价格低廉、原料利用率高、现象明显、无干扰物质以及无污染等特点。",
      "title": "最佳实验方案的选用",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m10",
      "source_node_ids": [
        "n-3766f094b85977a761a0"
      ],
      "text": "判断“实验操作、现象与结论”的正误时，检查实验操作和现象与结论或解释之间是否存在逻辑混乱或没有逻辑关系，并检查实验设计、操作本身是否错误或不够严密。",
      "title": "实验操作、现象与结论的逻辑审查",
      "status": "机器整理（待核对）"
    }
  ],
