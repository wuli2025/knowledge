{
  "concepts": [
    {
      "id": "c1",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "甲烷为正四面体结构，是判断有机物分子中原子空间位置的基本模型之一。",
      "title": "甲烷空间结构模型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c2",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "乙烯为平面结构，是判断有机物分子中原子共面的基本模型之一。",
      "title": "乙烯空间结构模型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c3",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "乙炔为直线结构，是判断有机物分子中原子共线的基本模型之一。",
      "title": "乙炔空间结构模型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c4",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "苯为平面结构，是判断有机物分子中原子共面的基本模型之一。",
      "title": "苯空间结构模型",
      "status": "机器整理（待核对）"
    },
    {
      "id": "c5",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "甲醛为平面结构，是判断有机物分子中原子共面的基本模型之一。",
      "title": "甲醛空间结构模型",
      "status": "机器整理（待核对）"
    }
  ],
  "laws": [
    {
      "id": "l1",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "有机物分子中的单键，包括碳碳单键、碳氢单键、碳氧单键等可旋转；环状结构中直接参与成环的单键一般不能旋转。碳碳双键和碳碳三键等不能旋转，对原子的空间位置具有“定格”作用。",
      "title": "单键旋转与空间位置限制",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l2",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "共平面的、不在同一直线上的 $3$ 个原子处于另一平面时，两平面必定重合，两平面内的所有原子必定共平面。",
      "title": "定平面规律",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l3",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "直线形分子中有 $2$ 个原子处于某一平面内时，该分子中的所有原子也必在此平面内。",
      "title": "定直线规律",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l4",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "结构中若存在饱和碳原子，则分子中所有原子一定不共平面。此结论的判断对象是“所有原子”。",
      "title": "含饱和碳原子时的共面限制",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l5",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "结构中若存在 $1$ 个苯环，则至少有 $12$ 个原子共平面。",
      "title": "苯环对应的共面原子数下限",
      "status": "机器整理（待核对）"
    },
    {
      "id": "l6",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "结构中若存在 $1$ 个碳碳双键，则至少有 $6$ 个原子共平面。",
      "title": "碳碳双键对应的共面原子数下限",
      "status": "机器整理（待核对）"
    }
  ],
  "methods": [
    {
      "id": "m1",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "读题时先明确判断对象及限定条件，注意“碳原子”“所有原子”“可能”“一定”“最少”“最多”“共线”和“共面”等表述，以及题目中的隐含条件和特殊规定。",
      "title": "辨明共线、共面问题的判断范围",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m2",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "以甲烷、乙烯、乙炔、苯和甲醛的空间结构为基本模型，结合单键旋转思想、定平面规律和定直线规律，判断有机物分子中原子的共线、共面情况；分析旋转时需注意直接参与成环的单键一般不能旋转。",
      "title": "基本模型与空间位置规律综合判断",
      "status": "机器整理（待核对）"
    },
    {
      "id": "m3",
      "source_node_ids": [
        "n-788b133179fff939fc7c"
      ],
      "text": "原文以 $\\mathrm{C_6H_5—C(=O)—C\\equiv C—CH_3}$ 为例：转动苯环与羰基碳之间的①处 $\\mathrm{C—C}$ 键，可使苯平面 $M_1$ 和酮平面 $M_2$ 在同一平面上。碳碳三键为直线形结构，位于酮平面 $M_2$ 上；甲基中的 $\\mathrm{H}$ 原子都不在该直线上。转动三键碳与甲基碳之间的②处 $\\mathrm{C—C}$ 键，可使甲基中的 $1$ 个 $\\mathrm{H}$ 原子位于酮平面 $M_2$ 上。",
      "title": "通过单键旋转分析可能共面的位置",
      "status": "机器整理（待核对）"
    }
  ],
